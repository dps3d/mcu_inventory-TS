# Підключення до зовнішньої хмарної PostgreSQL у Neon (Serverless Postgres)
DATABASE_URL=postgresql://neondb_owner:password@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Секретний ключ шифрування сесій та JWT-токенів Payload CMS
PAYLOAD_SECRET=your-super-secret-payload-key-minimum-24-chars

# URL-адреси сервісів для CORS та генерації посилань на медіафайли
CMS_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
